# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio ni contiene valores reales aquí.

# Puerto del servidor Express
PORT=3000

# Cadena de conexión de Azure Storage Account (cola y tabla)
QUEUE_CONNECTION_STRING=

# Nombre de la cola principal para eventos de notificaciones
QUEUE_NAME=notificaciones

# Nombre de la cola para mensajes inválidos o envenenados
POISON_QUEUE_NAME=notificaciones-poison

# Nombre de la tabla de Azure Table Storage para el historial
TABLE_NAME=notificaciones

# Intervalo de sondeo (polling) en milisegundos para el consumidor de cola
POLL_INTERVAL_MS=3000

# Tiempo de invisibilidad de mensajes en cola durante su procesamiento (en segundos)
VISIBILITY_TIMEOUT_S=30

# Cantidad máxima de reintentos antes de mover un mensaje a la cola de envenenados
MAX_DEQUEUE_COUNT=5
